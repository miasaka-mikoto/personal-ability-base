{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ability-base.dev/schemas/ability-manifest.schema.json",
  "title": "Personal Ability Base Ability Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "id", "name", "displayName", "version", "description",
    "author", "minCoreVersion", "platforms", "permissions", "dependencies",
    "optionalDependencies", "contributes", "entry"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "minCoreVersion": { "$ref": "#/$defs/semver" },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "android", "linux", "macos", "ios", "web"] } },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "oneOf": [{ "enum": ["storage.private", "storage.shared", "memory.read", "memory.write", "camera", "microphone", "location", "network", "clipboard", "notifications", "filesystem.import", "filesystem.export"] }, { "type": "string", "pattern": "^custom\\.[a-z0-9][a-z0-9.-]*$" }] } },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "optionalDependencies": { "$ref": "#/$defs/dependencies" },
    "conflicts": { "$ref": "#/$defs/dependencies" },
    "contributes": {
      "type": "object",
      "properties": {
        "pages": { "type": "array" },
        "commands": { "type": "array" },
        "cards": { "type": "array" },
        "searchProviders": { "type": "array" },
        "workflows": { "type": "array" },
        "settings": { "type": "array" }
      },
      "additionalProperties": true
    },
    "entry": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "runtime": { "type": "object", "properties": { "type": { "type": "string" }, "apiVersion": { "type": "integer", "minimum": 1 } }, "additionalProperties": true },
    "integrity": { "type": "object", "properties": { "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }, "signature": { "type": "string" }, "keyId": { "type": "string" } }, "additionalProperties": true },
    "signature": { "type": "object", "required": ["algorithm", "keyId", "value"], "properties": { "algorithm": { "type": "string", "minLength": 1 }, "keyId": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 }, "signedPayload": { "enum": ["package", "sha256"] } }, "additionalProperties": true }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "dependencies": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 }, "propertyNames": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } }
  }
}
